{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/**", "src/virtual/test-utils/**"],
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
