{
  "name": "@indielayer/ui",
  "version": "2.1.0",
  "description": "Indielayer UI Components with Tailwind CSS build for Vue 3",
  "author": {
    "name": "João Teixeira",
    "url": "https://indielayer.com/"
  },
  "keywords": [
    "vue",
    "vue 3",
    "tailwindcss",
    "components",
    "ui framework",
    "component framework",
    "ui library",
    "component library",
    "indielayer"
  ],
  "files": [
    "lib",
    "src",
    "docs",
    "*.d.ts",
    "exports",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.umd.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.umd.js",
      "types": "./lib/index.d.ts"
    },
    "./docs/*": "./docs/*",
    "./nuxt": "./exports/nuxt.mjs",
    "./nuxt.plugin": "./exports/nuxt.plugin.js",
    "./nuxt.plugin.js": "./exports/nuxt.plugin.js",
    "./tailwind.css": "./exports/tailwind.css"
  },
  "sideEffects": [
    "./exports/tailwind.css"
  ],
  "scripts": {
    "dev": "vite dev --mode docs --open",
    "build": "pnpm generate && vite build",
    "build:docs": "pnpm generate && vite-ssg build --mode docs",
    "build:prod": "pnpm build && pnpm gen:types",
    "build:watch": "pnpm generate && vite build --watch",
    "build:only": "vite build",
    "build:stats": "VITE_VISUALIZER=Y npm run build",
    "generate": "pnpm gen:version",
    "gen:types": "rm -rf lib/src lib/docs && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build-types.json",
    "gen:version": "node .scripts/gen-version.cjs",
    "gen:search": "node .scripts/gen-search.cjs",
    "gen:llms": "node .scripts/gen-llms.cjs",
    "gen:llms-full": "node .scripts/gen-llms-full.cjs",
    "gen:sitemap": "node .scripts/gen-sitemap.cjs",
    "test": "pnpm test:unit",
    "test:ci": "vitest run --environment jsdom",
    "test:unit": "vitest --environment jsdom",
    "typecheck": "pnpm generate && vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^21.1.1",
    "@types/node": "^22.12.0",
    "@unhead/vue": "^2.1.15",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "@vuepic/vue-datepicker": "^11.0.2",
    "@vueuse/core": "^11.1.0",
    "c8": "^7.12.0",
    "clean-css": "^5.3.0",
    "eslint": "^8.43.0",
    "floating-vue": "^5.2.2",
    "fuse.js": "^7.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.4",
    "rollup-plugin-visualizer": "^5.9.2",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2",
    "vite": "^8.0.14",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.7",
    "vue": "^3.5.18",
    "vue-router": "^4.2.2",
    "vue-tsc": "^1.8.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/indielayer/ui/issues"
  },
  "homepage": "https://github.com/indielayer/ui#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indielayer/ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
