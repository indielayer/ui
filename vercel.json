{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:docs",
  "outputDirectory": "packages/ui/dist",
  "installCommand": "pnpm install --prod=false",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/play/(.*)",
      "destination": "/index.html"
    }
  ]
}
